# 复制为 .env.docker 使用，真实配置文件不得提交到 Git。
IMAGE_TAG=local
DOCKER_DATA_DIR=./docker-data
APP_UID=1000
APP_GID=1000

APP_PORT=8001
QA_LOG_LEVEL=INFO
QA_MAX_ACTIVE_BROWSER_SESSIONS=3
QA_EXPLORATION_PLAN_TIMEOUT_SECONDS=120

# 全新数据库首次启动时必填；已有 admin 账号的数据库可留空。
QA_BOOTSTRAP_ADMIN_PASSWORD=

# HTTPS 部署配置。
SERVER_NAME=qa.example.com
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./docker-data/certs
CLIENT_MAX_BODY_SIZE=20m

# 可选。优先在平台页面中配置 AI。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
